# ============================================================================
# CLOACKING SYSTEM - Variáveis de Ambiente
# ============================================================================

# CLOAKING CONTROL
# ─────────────────────────────────────────────────────────────────────────
# true  = Phase 2: Bots veem página de advocacia, humanos veem página de vendas
# false = Phase 1: Todos veem página de vendas (desativa cloacking)
CLOAKING_ENABLED=true

# WHATSAPP CONTACT
# ─────────────────────────────────────────────────────────────────────────
# Número de WhatsApp com código do país (55 = Brasil)
# Formato: 55XXEXXXXXXXX (sem símbolos)
NEXT_PUBLIC_WHATSAPP_PHONE=5511999999999

# REDIRECT/COBRANCE URL (Opcional)
# ─────────────────────────────────────────────────────────────────────────
# URL para redirecionar usuários para plataforma de cobrança
NEXT_PUBLIC_COBRANCA_URL=https://pagoufacil.com.br

# PASCHA BOT DETECTION API (Recomendado para produção)
# ─────────────────────────────────────────────────────────────────────────
# Deixe vazio para usar detecção básica por User-Agent
# Preencha com credenciais reais para detecção avançada
NEXT_PUBLIC_PASCHA_URL=
PASCHA_API_KEY=
PASCHA_ML_KEY=

# REDIRECT DELAY (em milissegundos)
# ─────────────────────────────────────────────────────────────────────────
# Tempo de espera antes de redirecionar para Cobranca URL
REDIRECT_DELAY=2000
