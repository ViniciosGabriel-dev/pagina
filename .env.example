# Variáveis de Ambiente - Cloacker Project
# Para deployar no Vercel, configure estas variáveis no painel do Vercel

# Bot Detection API (PASCHA backend)
# Desenvolvimento: http://localhost:3009/api/detect-visitor
# Produção: https://cloacker-production-849d.up.railway.app/api/detect-visitor
BOT_DETECTION_API_URL=https://cloacker-production-849d.up.railway.app/api/detect-visitor

# API Key para autenticação com PASCHA
# Configurar no Vercel como variável de ambiente secreta
PASCHA_API_KEY=your-api-key-here

# Cloaking Control
# false = Phase 1 (todos veem landing page)
# true = Phase 2 (bots veem educativo, humanos veem vendas)
CLOAKING_ENABLED=true

# WhatsApp Contact
NEXT_PUBLIC_WHATSAPP_PHONE=5511986324895
