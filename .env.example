# ============================================================================
# CLOAKING SYSTEM - Variáveis de Ambiente
# ============================================================================

# 🤖 BOT DETECTION - PASCHA Backend Configuration
# ─────────────────────────────────────────────────────────────────────────
# URL do backend PASCHA para detecção avançada de bots
# LOCAL: http://localhost:3001
# STAGING: https://staging-backend.example.com
# PRODUCTION: https://api.example.com
NEXT_PUBLIC_PASCHA_URL=http://localhost:3001

# Timeout para requisições de detecção (em ms)
NEXT_PUBLIC_PASCHA_TIMEOUT=10000

# Chave de API para autenticação com backend (Bearer token)
PASCHA_API_KEY=your-api-key-here-min-32-chars

# Chave para coleta de dados ML (não exponha em cliente)
PASCHA_ML_KEY=your-ml-key-here-min-32-chars

# 🎭 CLOAKING CONTROL
# ─────────────────────────────────────────────────────────────────────────
# true  = Phase 2: Bots veem página de advocacia, humanos veem página de vendas
# false = Phase 1: Todos veem página de vendas (desativa cloacking)
CLOAKING_ENABLED=true

# Nível mínimo de confiança para considerar detecção válida
# Valores: low, medium, high, very-high
# Recomendado: high (mais seguro, menos falsos positivos)
CLOAKING_MIN_CONFIDENCE=high

# 📱 WHATSAPP CONTACT
# ─────────────────────────────────────────────────────────────────────────
# Número de WhatsApp com código do país (55 = Brasil)
# Formato: 55XXEXXXXXXXX (sem símbolos)
NEXT_PUBLIC_WHATSAPP_PHONE=5511986324895

# 🌍 ENVIRONMENT
# ─────────────────────────────────────────────────────────────────────────
NODE_ENV=development
