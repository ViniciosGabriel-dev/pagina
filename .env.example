# Variáveis de Ambiente - Cloacker Project
# Para deployar no Vercel, configure estas variáveis no painel do Vercel

# Bot Detection API (externa)
# URL da API de detecção de bots
# Desenvolvimento: http://localhost:3001/api/detect
# Produção: https://seu-bot-detection-api.com/api/detect
BOT_DETECTION_API_URL=http://localhost:3001/api/detect

# Cloaking Control
# false = Phase 1 (todos veem landing page)
# true = Phase 2 (bots veem educativo, humanos veem vendas)
CLOAKING_ENABLED=false

# WhatsApp Contact
NEXT_PUBLIC_WHATSAPP_PHONE=5511999999999
