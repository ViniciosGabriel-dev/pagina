# Variáveis de Ambiente - Cloacker PASCHA Integration
# Para deployar no Vercel, copie este arquivo para .env.production
# e preencha com os valores reais, ou configure no painel do Vercel

# PASCHA API Configuration
NEXT_PUBLIC_PASCHA_URL=https://cloacker-production-849d.up.railway.app
PASCHA_API_KEY=seu_api_key_aqui
PASCHA_ML_KEY=seu_ml_key_aqui

# Cloaking Control
# false = Phase 1 (todos veem landing page)
# true = Phase 2 (bots veem educativo, humanos veem vendas)
CLOAKING_ENABLED=false

# WhatsApp Contact
NEXT_PUBLIC_WHATSAPP_PHONE=5511999999999
